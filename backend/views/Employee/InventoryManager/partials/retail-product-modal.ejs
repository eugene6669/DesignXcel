<div id="addRetailProductModal" class="modal pi-modal-compact pi-create-product-modal">
    <div class="modal-content">
        <span class="close-button" id="closeRetailModal">&times;</span>
        <h3>Retail Product</h3>
        <form id="addRetailProductForm" class="pi-create-form" action="/Employee/InventoryManager/InventoryProducts/RetailAdd" method="POST" enctype="multipart/form-data">
            <div class="pi-plan-layout">
                <div class="pi-plan-col pi-plan-col-left">
                    <h4 class="pi-plan-col-group-title">Product Details</h4>
                    <div class="pi-section">
                        <div class="pi-form-grid pi-create-top">
                            <div class="form-group">
                                <label for="retailName">Product Name <span style="color:#dc3545;">*</span></label>
                                <input type="text" id="retailName" name="name" required>
                            </div>
                            <div class="form-group">
                                <label for="retailProductCostPrice">Item Cost Price (₱) <span style="color:#dc3545;">*</span></label>
                                <input type="text" id="retailProductCostPrice" name="costPrice" inputmode="decimal" autocomplete="off" required placeholder="0.00">
                            </div>
                            <div class="form-group">
                                <label for="retailProductPrice">Sale Price (₱) <span style="color:#dc3545;">*</span></label>
                                <input type="text" id="retailProductPrice" name="price" inputmode="decimal" autocomplete="off" required placeholder="0.00">
                            </div>
                            <div class="form-group">
                                <label for="retailCategory">Category <span style="color:#dc3545;">*</span></label>
                                <select id="retailCategory" name="category" required>
                                    <option value="">Select category</option>
                                    <% if (categories && categories.length > 0) { %>
                                        <% categories.forEach(cat => { %>
                                            <option value="<%= cat %>"><%= cat %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="retailDescription">Description / notes</label>
                            <textarea id="retailDescription" name="description" rows="2" placeholder="Optional"></textarea>
                        </div>

                        <div class="form-group pi-product-dims">
                            <label>Dimensions (L × W × H cm)</label>
                            <div class="pi-var-dims-inline">
                                <label for="retailProductLength">L</label>
                                <input type="number" id="retailProductLength" name="length" step="0.1" min="0" placeholder="cm">
                                <label for="retailProductWidth">W</label>
                                <input type="number" id="retailProductWidth" name="width" step="0.1" min="0" placeholder="cm">
                                <label for="retailProductHeight">H</label>
                                <input type="number" id="retailProductHeight" name="height" step="0.1" min="0" placeholder="cm">
                            </div>
                            <small style="display:block;margin-top:4px;color:#666;">Same size for all variations of this product.</small>
                        </div>

                        <div>
                            <label for="retailProductMainImage">Product Main Image</label>
                            <input type="file" id="retailProductMainImage" name="productMainImage" accept="image/*">
                        </div>
                    </div>
                </div>

                <div class="pi-plan-col pi-plan-col-right">
                    <div class="pi-section">
                        <h4>Product Variations <span style="color:#dc3545;">*</span></h4>
                        <div id="retailProductVariationsList"></div>
                        <button type="button" id="addRetailProductVariationBtn" class="pi-btn pi-btn-primary pi-btn-sm" style="margin-top:6px;">+ Add Variation</button>
                    </div>
                    <input type="hidden" id="retailVariationsJson" name="variationsJson" value="">
                    <input type="hidden" id="retailDeletedVariationIds" name="deletedVariationIds" value="[]">
                </div>
            </div>

            <div class="pi-form-actions">
                <button type="button" id="cancelRetailProduct" class="pi-btn pi-btn-secondary">Cancel</button>
                <button type="submit" class="pi-btn pi-btn-primary" id="submitRetailProductBtn">Save Retail Product</button>
            </div>
        </form>
    </div>
</div>
