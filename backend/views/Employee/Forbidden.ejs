<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied - Design Excellence</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/Employee/employee-forbidden.css">
</head>
<body>
    <div class="forbidden-container">
        <div class="forbidden-icon">&#9888;</div>
        <div class="forbidden-title">Access Denied</div>
        <div class="forbidden-message">
            Sorry, you do not have permission to access this section.<br>
            Please contact your administrator if you believe this is a mistake.
        </div>
        <div class="forbidden-actions">
            <button type="button" class="forbidden-btn" onclick="goToDashboard()">Go to Dashboard</button>
            <button type="button" class="forbidden-btn secondary" onclick="window.history.back()">Go Back</button>
        </div>
    </div>

    <script>
        function goToDashboard() {
            const userRole = '<%= typeof user !== "undefined" && user.role ? user.role : "Guest" %>';

            switch (userRole) {
                case 'Admin':
                    window.location.href = '/Employee/AdminManager';
                    break;
                case 'InventoryManager':
                    window.location.href = '/Employee/InventoryManager';
                    break;
                case 'TransactionManager':
                    window.location.href = '/Employee/TransactionManager';
                    break;
                case 'UserManager':
                    window.location.href = '/Employee/UserManager';
                    break;
                case 'OrderSupport':
                    window.location.href = '/Employee/OrderSupport';
                    break;
                default:
                    window.location.href = '/login';
                    break;
            }
        }
    </script>
</body>
</html>
